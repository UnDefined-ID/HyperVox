# Builds SteelMC (steel-provider/) as a static library and links it into the game - pure CMake, no bash, so it works on Windows (MSVC or MinGW), Linux and macOS.
# Needs: Rust (https://rustup.rs - the pinned nightly in steel-provider/rust-toolchain.toml is installed by rustup on the first build), internet for the first build.
# Cache variables: HV_DATA_VERSION (net.minestom:data version of the pinned SteelMC), HV_STEEL_NATIVE_LIBS (override the system libraries Rust's std needs)
set(HV_DATA_VERSION "26.3-rv1" CACHE STRING "net.minestom:data version the pinned SteelMC targets")
set(STEEL_DIR ${CMAKE_SOURCE_DIR}/steel)
file(MAKE_DIRECTORY ${STEEL_DIR})

find_program(HV_CARGO cargo HINTS "$ENV{USERPROFILE}/.cargo/bin" "$ENV{HOME}/.cargo/bin" "$ENV{CARGO_HOME}/bin")
find_program(HV_RUSTUP rustup HINTS "$ENV{USERPROFILE}/.cargo/bin" "$ENV{HOME}/.cargo/bin" "$ENV{CARGO_HOME}/bin")
if(NOT HV_CARGO)
  message(FATAL_ERROR "Rust (cargo) not found. Install it from https://rustup.rs and re-run CMake - or configure with -DHV_STEEL_STATIC=OFF.")
endif()

# ---- which Rust target matches this compiler (64-bit only)
if(NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "SteelMC needs a 64-bit build")
endif()
string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" _proc)
set(_arm OFF)
if(_proc MATCHES "arm64|aarch64")
  set(_arm ON)
endif()
if(MSVC)
  set(HV_RUST_TARGET "${_arm}" )
  if(_arm)
    set(HV_RUST_TARGET aarch64-pc-windows-msvc)
  else()
    set(HV_RUST_TARGET x86_64-pc-windows-msvc)
  endif()
  set(HV_STEEL_LIBFILE steel_provider.lib)
  set(_native ws2_32 userenv ntdll bcrypt advapi32 kernel32 synchronization dbghelp)
elseif(WIN32)       # MinGW / MSYS2
  set(HV_RUST_TARGET x86_64-pc-windows-gnu)
  set(HV_STEEL_LIBFILE libsteel_provider.a)
  set(_native ws2_32 userenv ntdll bcrypt advapi32 kernel32 synchronization pthread)
elseif(APPLE)
  if(_arm)
    set(HV_RUST_TARGET aarch64-apple-darwin)
  else()
    set(HV_RUST_TARGET x86_64-apple-darwin)
  endif()
  set(HV_STEEL_LIBFILE libsteel_provider.a)
  set(_native "-framework Security" "-framework CoreFoundation" resolv)
else()
  if(_arm)
    set(HV_RUST_TARGET aarch64-unknown-linux-gnu)
  else()
    set(HV_RUST_TARGET x86_64-unknown-linux-gnu)
  endif()
  set(HV_STEEL_LIBFILE libsteel_provider.a)
  set(_native pthread dl m)
endif()
if(HV_STEEL_NATIVE_LIBS)
  set(_native ${HV_STEEL_NATIVE_LIBS})
endif()

# ---- data jar -> block.json (the block-state table the game uses to decode Steel's chunks)
set(STEEL_JAR ${STEEL_DIR}/.data-${HV_DATA_VERSION}.jar)
if(NOT EXISTS ${STEEL_JAR})
  set(_got FALSE)
  foreach(_ver ${HV_DATA_VERSION})
    foreach(_base https://repo1.maven.org/maven2 https://reposilite.bluedragonmc.com/releases)
      if(NOT _got)
        set(_url ${_base}/net/minestom/data/${_ver}/data-${_ver}.jar)
        message(STATUS "Downloading ${_url}")
        file(DOWNLOAD ${_url} ${STEEL_JAR}.tmp STATUS _st TLS_VERIFY ON)
        list(GET _st 0 _code)
        if(_code EQUAL 0)
          file(RENAME ${STEEL_JAR}.tmp ${STEEL_JAR})
          set(_got TRUE)
        else()
          file(REMOVE ${STEEL_JAR}.tmp)
        endif()
      endif()
    endforeach()
  endforeach()
  if(NOT _got)
    message(FATAL_ERROR "Could not download net.minestom:data:${HV_DATA_VERSION}. Put data-${HV_DATA_VERSION}.jar at ${STEEL_JAR} and re-run CMake.")
  endif()
endif()
if(NOT EXISTS ${STEEL_DIR}/block.json)
  file(MAKE_DIRECTORY ${STEEL_DIR}/_x)
  execute_process(COMMAND ${CMAKE_COMMAND} -E tar xf ${STEEL_JAR} net/minestom/data/block.json WORKING_DIRECTORY ${STEEL_DIR}/_x RESULT_VARIABLE _rc)
  if(NOT _rc EQUAL 0 OR NOT EXISTS ${STEEL_DIR}/_x/net/minestom/data/block.json)
    message(FATAL_ERROR "block.json is not inside ${STEEL_JAR}")
  endif()
  file(COPY ${STEEL_DIR}/_x/net/minestom/data/block.json DESTINATION ${STEEL_DIR})
  file(REMOVE_RECURSE ${STEEL_DIR}/_x)
endif()

# ---- the static library itself
set(STEEL_LIB ${CMAKE_SOURCE_DIR}/steel-provider/target/${HV_RUST_TARGET}/release/${HV_STEEL_LIBFILE})
file(GLOB_RECURSE STEEL_RS_SOURCES ${CMAKE_SOURCE_DIR}/steel-provider/src/*.rs)
set(_steps "")
if(HV_RUSTUP)
  list(APPEND _steps COMMAND ${HV_RUSTUP} target add ${HV_RUST_TARGET})
endif()
add_custom_command(OUTPUT ${STEEL_LIB}
  ${_steps}
  COMMAND ${CMAKE_COMMAND} -E env MINESTOM_DATA_FROM_JAR=${STEEL_JAR} MINESTOM_DATA_TO_JAR=${STEEL_JAR}
          ${HV_CARGO} build --release --lib --target ${HV_RUST_TARGET}
  WORKING_DIRECTORY ${CMAKE_SOURCE_DIR}/steel-provider
  DEPENDS ${CMAKE_SOURCE_DIR}/steel-provider/Cargo.toml ${CMAKE_SOURCE_DIR}/steel-provider/build.rs ${STEEL_RS_SOURCES}
  COMMENT "Building SteelMC (first build takes several minutes) ..." VERBATIM)
add_custom_target(steel_lib DEPENDS ${STEEL_LIB})
add_library(steel_provider STATIC IMPORTED GLOBAL)
set_target_properties(steel_provider PROPERTIES IMPORTED_LOCATION ${STEEL_LIB})
add_dependencies(steel_provider steel_lib)
target_compile_definitions(minecraft PRIVATE HV_STEEL_STATIC)
set_source_files_properties(src/SteelClient.cpp PROPERTIES COMPILE_DEFINITIONS HV_STEEL_STATIC)
target_link_libraries(minecraft PRIVATE steel_provider ${_native})
message(STATUS "SteelMC will be linked in statically (${HV_RUST_TARGET}, data ${HV_DATA_VERSION})")
